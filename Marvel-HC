};

const HEROES = [
  { key:'miner',    icon:ICONS.miner,    name:'Miner',           desc: l => `+${l+1} profit per strike`,      baseCost: 100,  growth: 1.55, max: 200, accent:'#4CDC6E', accentSoft:'rgba(76,220,110,.18)' },
  { key:'reactor',  icon:ICONS.reactor,  name:'Arc Reactor',     desc: l => `+${(l+1)*500} energy capacity`,  baseCost: 500,  growth: 1.85, max: 30,  accent:'#4DA6FF', accentSoft:'rgba(77,166,255,.15)' },
  { key:'vibranium',icon:ICONS.vibranium,name:'Vibranium Core',  desc: l => `+${(l+1)*2} energy regen / sec`, baseCost: 800,  growth: 1.95, max: 20,  accent:'#B080FF', accentSoft:'rgba(176,128,255,.15)' },
  { key:'legion',   icon:ICONS.legion,   name:'Iron Legion',     desc: l => `${(l+1)*2} credits / sec auto`,  baseCost: 3000, growth: 2.1,  max: 20,  accent:'#E62429', accentSoft:'rgba(230,36,41,.15)' },
  { key:'infinity', icon:ICONS.infinity, name:'Infinity Stone',  desc: l => `${(l+1)*2}% critical hit chance`,baseCost: 6000, growth: 2.2,  max: 15,  accent:'#FFB800', accentSoft:'rgba(255,184,0,.18)' },
  { key:'mjolnir',  icon:ICONS.mjolnir,  name:'Mjolnir Strike',  desc: l => `${(l+1)*1}% chance of ×3 damage`,baseCost: 15000,growth: 2.4,  max: 10,  accent:'#FFB800', accentSoft:'rgba(255,184,0,.18)' },
];

const RANKS = [
  { name:'RECRUIT',    min:0 }, { name:'AGENT',      min:2_500 },
  { name:'SPECIALIST', min:15_000 }, { name:'COMMANDER',  min:75_000 },
  { name:'DIRECTOR',   min:350_000 }, { name:'LEGEND',     min:1_500_000 },
  { name:'AVENGER',    min:6_000_000 }, { name:'INFINITY',   min:25_000_000 },
  { name:'COSMIC',     min:100_000_000 },
