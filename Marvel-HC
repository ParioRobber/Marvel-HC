const DAILY_MISSIONS = [
  { id:'d1', icon:'👊', title:'Warm Up',     desc:'Land 50 strikes',         need:50,   reward:120, goldReward:0, prog:s=>s.stats.todayClicks||0 },
  { id:'d2', icon:'🔥', title:'Combo Rush',  desc:'Reach a ×2.00 combo',     need:200,  reward:180, goldReward:0, prog:s=>(s.stats.todayMaxCombo||0)*100 },
  { id:'d3', icon:'💥', title:'Critical Eye',desc:'Land 10 critical hits',   need:10,   reward:220, goldReward:0, prog:s=>s.stats.todayCrits||0 },
  { id:'d4', icon:'⛏️', title:'Miner Day',   desc:'Upgrade the Miner once',  need:1,    reward:150, goldReward:1, prog:s=>s.stats.todayUpgrades||0 },
];
