  sheetTitle.innerHTML = titles[view] || '';
  if(view==='shop')         renderShop();
  if(view==='missions')     renderMissions();
  if(view==='achievements') renderAchievements();
  if(view==='settings')     renderSettings();
  sheetOverlay.classList.add('show'); sheet.classList.add('show');
  const sb = document.getElementById('streakBtn'); if(sb) sb.onclick = claimStreak;
}
function closeSheet(){ sheetOverlay.classList.remove('show'); sheet.classList.remove('show'); }

/* REWARD POPUP */
let popupTimer;
function popReward(icon, title, amount, sub){
  $('#rpIcon').textContent = icon;
  $('#rpTitle').textContent = title;
  $('#rpAmount').textContent = amount;
  $('#rpSub').textContent = sub || '';
  rewardPopup.classList.add('show');
  clearTimeout(popupTimer);
  popupTimer = setTimeout(()=>rewardPopup.classList.remove('show'), 2400);
}

/* FX */
function lightningStrike(){ lightning.classList.add('flash'); setTimeout(()=>lightning.classList.remove('flash'), 600); }
function addKillfeed(txt){ const el = document.createElement('div'); el.className = 'kf'; el.textContent = txt; killfeed.appendChild(el); setTimeout(()=>el.remove(), 2300); }
function spawnFloaty(x,y,txt,type){
  const el = document.createElement('div');
  el.className = 'floaty'; el.textContent = txt;
  el.style.left = x+'px'; el.style.top = y+'px';
  if(type==='crit'){ el.style.color='#4DA6FF'; el.style.fontSize='32px'; el.style.textShadow='0 0 25px rgba(77,166,255,1),0 0 60px rgba(77,166,255,.6)'; }
  if(type==='mega'){ el.style.color='#E62429'; el.style.fontSize='42px'; el.style.textShadow='0 0 30px rgba(230,36,41,1),0 0 70px rgba(255,184,0,.8)'; }
  coinArea.appendChild(el); setTimeout(()=>el.remove(), 1100);
}
function spawnParticles(x,y,type){
  const palettes = { normal:['#FFB800','#FFE27A','#fff','#E62429'], crit:['#4DA6FF','#9DC8FF','#fff','#B080FF'], mega:['#E62429','#FF4B52','#FFB800','#fff','#FFE27A'] };
  const colors = palettes[type] || palettes.normal;
  const count = type==='normal'?12:type==='crit'?22:34;
  for(let i=0;i<count;i++){
    const p = document.createElement('div'); p.className='pt';
    const ang = Math.random()*Math.PI*2;
    const d = 40+Math.random()*140;
    p.style.setProperty('--dx', Math.cos(ang)*d+'px');
    p.style.setProperty('--dy', Math.sin(ang)*d+'px');
    p.style.left=x+'px'; p.style.top=y+'px';
    const c = colors[i%colors.length]; const size = 4+Math.random()*7;
    p.style.width=p.style.height=size+'px';
    p.style.background=c; p.style.boxShadow=`0 0 15px ${c}, 0 0 30px ${c}`;
    coinArea.appendChild(p); setTimeout(()=>p.remove(), 1000);
  }
  if(type !== 'normal'){
    const gCount = type==='mega'?8:4;
    for(let i=0;i<gCount;i++){
      const g = document.createElement('div'); g.className='glass';
      const ang = Math.random()*Math.PI*2;
      const d = 60+Math.random()*120;
      g.style.setProperty('--dx', Math.cos(ang)*d+'px');
      g.style.setProperty('--dy', Math.sin(ang)*d+'px');
      g.style.left=x+'px'; g.style.top=y+'px';
      const size = 6+Math.random()*8;
      g.style.width=g.style.height=size+'px';
      coinArea.appendChild(g); setTimeout(()=>g.remove(), 1100);
    }
  }
}
function spawnRipple(x,y){ const el = document.createElement('div'); el.className='ripple'; el.style.left=x+'px'; el.style.top=y+'px'; coinArea.appendChild(el); setTimeout(()=>el.remove(), 750); }
function spawnSparks(x,y,type){
  if(type==='normal') return;
  const count = type==='mega'?10:5;
  for(let i=0;i<count;i++){
    const s = document.createElement('div'); s.className='sparkLine';
    const ang = Math.random()*180; const len = 30+Math.random()*100;
    s.style.left=x+'px'; s.style.top=y+'px'; s.style.width=len+'px';
    s.style.transform = `translate(-50%,-50%) rotate(${ang}deg)`;
    s.style.background = type==='mega' ? 'linear-gradient(90deg,transparent,#FFB800,#fff,#FFB800,transparent)' : 'linear-gradient(90deg,transparent,#4DA6FF,#fff,#4DA6FF,transparent)';
    coinArea.appendChild(s); setTimeout(()=>s.remove(), 550);
  }
}
function critFlash(){ const el = document.createElement('div'); el.className='critFlash'; document.body.appendChild(el); setTimeout(()=>el.remove(), 450); }
function megaFlash(){ const el = document.createElement('div'); el.className='megaFlash'; document.body.appendChild(el); setTimeout(()=>el.remove(), 600); }
function shakeScreen(){ appEl.classList.add('shake'); setTimeout(()=>appEl.classList.remove('shake'), 340); }

/* STRIKE */
let comboCount = 0, lastTapTime = 0, comboResetTimer = null;
function strike(e){
  ensureAudio();
  if(!state) return;
  if(state.energy < ENERGY_COST){ showToast('NOT ENOUGH ENERGY'); SFX.err(); return; }
  const now = performance.now();
  if(now - lastTapTime < 800) comboCount++; else comboCount = 1;
  lastTapTime = now;
  if(comboCount > state.maxCombo) state.maxCombo = comboCount;
  if(comboCount > (state.stats.todayMaxCombo||0)) state.stats.todayMaxCombo = comboCount;
  if(comboCount > (state.stats.weekMaxCombo||0)) state.stats.weekMaxCombo = comboCount;
  const comboMult = Math.min(1 + comboCount*0.04, 5);
  state.combo = comboMult;
  let dmg = state.perClick; let fx = 'normal';
  const critC = (state.upgrades.infinity||0)*2;
  const megaC = (state.upgrades.mjolnir||0)*1;
  if(Math.random()*100 < megaC){ dmg *= 3; fx='mega'; state.stats.todayCrits = (state.stats.todayCrits||0)+1; }
  else if(Math.random()*100 < critC){ dmg *= 2; fx='crit'; state.stats.todayCrits = (state.stats.todayCrits||0)+1; }
  dmg = Math.floor(dmg * comboMult);
  state.energy -= ENERGY_COST;
  if(state.energy < 0) state.energy = 0;
  state.score += dmg; state.totalClicks++;
  state.stats.todayClicks = (state.stats.todayClicks||0) + 1;
  state.stats.weekClicks = (state.stats.weekClicks||0) + 1;
  state.stats.weekEarned = (state.stats.weekEarned||0) + dmg;
  const rect = coinArea.getBoundingClientRect();
  const x = (e.clientX ?? rect.left+rect.width/2) - rect.left;
  const y = (e.clientY ?? rect.top+rect.height/2) - rect.top;
  spawnFloaty(x, y, '+'+fmt(dmg), fx);
  spawnParticles(x, y, fx);
  spawnRipple(x, y);
  spawnSparks(x, y, fx);
  scoreEl.classList.add('pop'); setTimeout(()=>scoreEl.classList.remove('pop'), 110);
  coin.classList.add('hit'); setTimeout(()=>coin.classList.remove('hit'), 90);
  if(comboCount >= 5){
    const tier = comboCount >= 30 ? 'x4' : comboCount >= 18 ? 'x3' : comboCount >= 9 ? 'x2' : '';
    comboBadge.textContent = 'COMBO ×'+comboCount;
    comboBadge.className = 'comboBadge show ' + tier;
    comboEdge.classList.add('show');
    clearTimeout(comboResetTimer);
    comboResetTimer = setTimeout(()=>{ comboBadge.classList.remove('show'); comboEdge.classList.remove('show'); }, 900);
  }
  if(fx==='mega'){ SFX.mega(); megaFlash(); shakeScreen(); addKillfeed('💥 MEGA-KILL +'+fmt(dmg)); lightningStrike(); }
  else if(fx==='crit'){ SFX.crit(); critFlash(); shakeScreen(); addKillfeed('⚡ CRITICAL +'+fmt(dmg)); }
  else if(comboCount%15 === 0 && comboCount > 0){ addKillfeed('🔥 COMBO ×'+comboCount); SFX.tap(comboCount); }
  else { SFX.tap(comboCount); }
  if(navigator.vibrate){
    if(fx==='mega') navigator.vibrate([20,10,40]);
    else if(fx==='crit') navigator.vibrate([15,10,25]);
    else if(comboCount%5===0) navigator.vibrate(8);
  }
  render();
  checkAchievements();
}

const ACHV = [
  { id:'a1', check:s=>s.totalClicks>=1 },
  { id:'a2', check:s=>s.totalClicks>=100 },
  { id:'a3', check:s=>s.totalClicks>=1000 },
  { id:'a4', check:s=>s.totalClicks>=10000 },
  { id:'a5', check:s=>s.score>=1_000_000 },
  { id:'a6', check:s=>(s.maxCombo||0)>=300 },
  { id:'a7', check:s=>(s.streak||0)>=7 },
  { id:'a8', check:s=>(s.upgrades?.miner||0)>=25 },
  { id:'a9', check:s=>(s.gold||0)>=10 },
];
function checkAchievements(){
  for(const a of ACHV){
    if(!state.achv[a.id] && a.check(state)){
      state.achv[a.id] = true;
      showToast('🏆 ACHIEVEMENT UNLOCKED', true);
      SFX.achv();
    }
  }
}

/* TOAST */
let toastTimer;
function showToast(msg, ok=false){
  toast.textContent = msg;
  toast.className = '';
  if(ok === true) toast.classList.add('ok');
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>toast.classList.remove('show'), 2000);
}

/* LOOP */
let lastTick = performance.now();
function tick(now){
  const dt = Math.min((now-lastTick)/1000, 1);
  lastTick = now;
  if(!state){ requestAnimationFrame(tick); return; }
  if(state.energy < state.energyMax) state.energy = Math.min(state.energy + state.regen*dt, state.energyMax);
  const auto = (state.upgrades.legion||0)*2;
  if(auto>0) state.score += auto*dt;
  const idle = (now - lastTapTime)/1000;
  if(idle > 0.8 && state.combo > 1) state.combo = Math.max(1, state.combo - dt*2);
  if(!tick.counter || now - tick.counter > 1000){ tick.counter = now; checkResets(); }
  render();
  requestAnimationFrame(tick);
}

/* PARALLAX */
let mouseX = 50, mouseY = 40, targetMX = 50, targetMY = 40;
function updateParallax(){
  mouseX += (targetMX - mouseX) * 0.06;
  mouseY += (targetMY - mouseY) * 0.06;
  const dx = (mouseX - 50) / 50; const dy = (mouseY - 50) / 50;
  bgStage.style.transform = `translate3d(${dx*-15}px, ${dy*-15}px, 0)`;
  dynLight.style.transform = `translate(${mouseX}%, ${mouseY}%) translate(-50%,-50%)`;
  requestAnimationFrame(updateParallax);
}
updateParallax();
window.addEventListener('pointermove', e=>{
  targetMX = (e.clientX / window.innerWidth) * 100;
  targetMY = (e.clientY / window.innerHeight) * 100;
});

/* EVENTS */
coin.addEventListener('pointerdown', e=>{ e.preventDefault(); strike(e); });
coin.addEventListener('touchstart', e=>{
  ensureAudio();
  for(let i=0;i<e.touches.length;i++){ const t = e.touches[i]; strike({ clientX:t.clientX, clientY:t.clientY }); }
}, { passive:true });
window.addEventListener('keydown', e=>{
  if(e.code==='Space' && !authOverlay.classList.contains('show') && !document.getElementById('updateOverlay').classList.contains('show')){
    e.preventDefault();
    const r = coin.getBoundingClientRect();
    strike({ clientX:r.left+r.width/2, clientY:r.top+r.height/2 });
  }
});
$$('.navItem').forEach(item=>{
  item.onclick = ()=>{ $$('.navItem').forEach(x=>x.classList.remove('active')); item.classList.add('active'); openSheet(item.dataset.view); SFX.tap(1); };
});
sheetOverlay.onclick = closeSheet;
$('#sheetClose').onclick = closeSheet;
let touchStartY = 0;
sheet.addEventListener('touchstart', e=>{ touchStartY = e.touches[0].clientY; }, {passive:true});
sheet.addEventListener('touchmove', e=>{ const dy = e.touches[0].clientY - touchStartY; if(dy > 70 && sheet.scrollTop === 0) closeSheet(); }, {passive:true});
$('#settingsBtn').onclick = ()=>{ $$('.navItem').forEach(x=>x.classList.remove('active')); openSheet('settings'); SFX.tap(1); };
let lastTouch = 0;
document.addEventListener('touchend', e=>{ const now = Date.now(); if(now - lastTouch < 300) e.preventDefault(); lastTouch = now; }, {passive:false});

/* UPDATE POPUP */
function showUpdatePopup(){ document.getElementById('updateOverlay').classList.add('show'); }
$('#updateClose').onclick = ()=>{ document.getElementById('updateOverlay').classList.remove('show'); state.updateSeen = UPDATE_VERSION; saveState(); showToast('▶ BACK TO GAME', true); };
$('#updateSettingsFromPopup').onclick = ()=>{ document.getElementById('updateOverlay').classList.remove('show'); state.updateSeen = UPDATE_VERSION; saveState(); setTimeout(()=>{ $$('.navItem').forEach(x=>x.classList.remove('active')); openSheet('settings'); }, 400); };

/* INTRO */
function hideIntro(){
  const intro = document.getElementById('intro');
  if(!intro) return;
  intro.classList.add('hide');
  state.introSeen = true; saveState();
  setTimeout(()=>{ if(state.updateSeen !== UPDATE_VERSION) showUpdatePopup(); }, 800);
}
$('#introSkip').onclick = hideIntro;

/* BOOT */
if(auth.current && auth.accounts[auth.current]) setTimeout(()=>enterGame(), 100);
else if(auth.guestSave === 'guest') setTimeout(()=>enterGame(), 100);
else { authOverlay.classList.add('show'); setTimeout(()=>$('#authUser').focus(), 800); }

lastTick = performance.now();
requestAnimationFrame(tick);
</script>
