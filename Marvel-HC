<script>
/* ============================================================
   MARVELS : HARD COMEBACK — V2.2
   Built by Parham.KH
   ============================================================ */
const SAVE_KEY_PREFIX = 'marvels_god_';
const AUTH_KEY = 'marvels_auth_v4';
const UPDATE_VERSION = '2.0';
const ENERGY_COST = 10;

/* AUTH */
let auth = loadAuth();
let currentSaveKey = null;
function loadAuth(){ try{ const raw = localStorage.getItem(AUTH_KEY); if(!raw) return { accounts:{}, current:null, guestSave:null }; return JSON.parse(raw); }catch{ return { accounts:{}, current:null, guestSave:null }; } }
function saveAuth(){ try{ localStorage.setItem(AUTH_KEY, JSON.stringify(auth)); }catch{} }
function hashPassword(pw){ let h = 5381; const str = 'marvels_hc_salt_2026' + pw; for(let i=0;i<str.length;i++){ h = ((h << 5) + h) + str.charCodeAt(i); h = h & 0xffffffff; } return 'h_' + Math.abs(h).toString(36); }

/* STATE */
function defaultState(){
  const now = Date.now();
  return {
    score:0, gold:0,
    totalClicks:0, perClick:1, energy:1000, energyMax:1000, regen:10, level:1,
    combo:1, maxCombo:1, comboCount:0,
    upgrades:{ miner:0, reactor:0, vibranium:0, legion:0, infinity:0, mjolnir:0 },
    achv:{}, daily:{}, weekly:{},
    lastDailyReset: now, lastWeeklyReset: now,
    stats:{ todayClicks:0, todayCrits:0, todayMaxCombo:0, todayUpgrades:0, weekClicks:0, weekEarned:0, weekUpgrades:0, weekMaxCombo:0 },
    streak:0, lastStreakClaim:0, lastSeen: now,
    introSeen: false, updateSeen: null,
  };
}
let state = null;
function loadState(){
  try{
    if(!currentSaveKey) return defaultState();
    const raw = localStorage.getItem(currentSaveKey);
    if(!raw) return defaultState();
    const s = { ...defaultState(), ...JSON.parse(raw) };
    s.upgrades = { ...defaultState().upgrades, ...(s.upgrades||{}) };
    s.stats = { ...defaultState().stats, ...(s.stats||{}) };
    const elapsed = Math.min((Date.now()-(s.lastSeen||Date.now()))/1000, 3600*4);
    if(elapsed > 5){
      const rate = (s.upgrades?.legion||0)*2;
      if(rate>0) s.score += Math.floor(rate*elapsed*0.4);
      s.energy = Math.min(s.energy + s.regen*elapsed, s.energyMax);
    }
    return s;
  }catch{ return defaultState(); }
}
function saveState(){ if(!state) return; state.lastSeen = Date.now(); try{ if(currentSaveKey) localStorage.setItem(currentSaveKey, JSON.stringify(state)); }catch{} }
setInterval(saveState, 2000);
window.addEventListener('beforeunload', saveState);

/* HELPERS */
const $ = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);
function costOf(h){ const lv = state.upgrades[h.key]||0; return Math.floor(h.baseCost * Math.pow(h.growth, lv)); }
function fmt(n){
  n = Math.floor(n);
  if(n<1000) return n.toString();
  if(n<1e6) return (n/1e3).toFixed(n<1e4?2:1).replace(/\.?0+$/,'')+'K';
  if(n<1e9) return (n/1e6).toFixed(n<1e7?2:1).replace(/\.?0+$/,'')+'M';
  if(n<1e12) return (n/1e9).toFixed(2).replace(/\.?0+$/,'')+'B';
  return (n/1e12).toFixed(2)+'T';
}
function rankOf(score){ let r = RANKS[0]; for(const x of RANKS) if(score>=x.min) r=x; return r.name; }

/* CONTENT */
const ICONS = {
  miner: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 3.5 L20.5 9.5"/><path d="M3.5 20.5 L14.5 9.5 L15.5 10.5 L4.5 21.5 Z" fill="currentColor" opacity=".2"/><path d="M3.5 20.5 L14.5 9.5 L15.5 10.5 L4.5 21.5 Z"/><path d="M20.5 3.5 C 15 1, 10 1.5, 6 4.5" stroke-width="2"/><circle cx="20.5" cy="9.5" r="1.6" fill="currentColor"/></svg>`,
