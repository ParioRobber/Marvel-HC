/* RESETS */
function checkResets(){
  const now = Date.now();
  if(now - state.lastDailyReset > 24*3600*1000){
    state.lastDailyReset = now; state.daily = {};
    state.stats.todayClicks = 0; state.stats.todayCrits = 0;
    state.stats.todayMaxCombo = 0; state.stats.todayUpgrades = 0;
    if(now - state.lastStreakClaim > 48*3600*1000) state.streak = 0;
    saveState(); showToast('📅 DAILY MISSIONS RESET');
  }
  if(now - state.lastWeeklyReset > 7*24*3600*1000){
    state.lastWeeklyReset = now; state.weekly = {};
    state.stats.weekClicks = 0; state.stats.weekEarned = 0;
    state.stats.weekUpgrades = 0; state.stats.weekMaxCombo = 0;
    saveState(); showToast('📆 WEEKLY MISSIONS RESET');
  }
}

/* RENDER */
function render(){
  if(!state) return;
  scoreEl.textContent = fmt(state.score);
  perClickEl.textContent = '+'+state.perClick;
  comboTxt.textContent = '×'+state.combo.toFixed(2);
  energyEl.textContent = Math.floor(state.energy);
  energyMaxEl.textContent = state.energyMax;
  const pct = Math.max(0, state.energy/state.energyMax*100);
  energyFill.style.width = pct+'%';
  energyFill.classList.toggle('low', pct<25);
  rankTxt.textContent = rankOf(state.score);
  goldTxt.textContent = fmt(state.gold||0);
  minerTxt.textContent = state.perClick;
  updateBadges();
}
function updateBadges(){
  const dd = DAILY_MISSIONS.filter(m => { const p = Math.min(m.prog(state), m.need); return p>=m.need && state.daily[m.id]!=='claimed'; }).length;
  const wd = WEEKLY_MISSIONS.filter(m => { const p = Math.min(m.prog(state), m.need); return p>=m.need && state.weekly[m.id]!=='claimed'; }).length;
  const total = dd + wd;
  if(total > 0){ missionBadge.classList.remove('hidden'); missionBadge.textContent = total; }
  else missionBadge.classList.add('hidden');
}

/* SHOP */
function renderShop(){
  let html = '<div class="heroGrid">';
  for(const h of HEROES){
    const lv = state.upgrades[h.key]||0;
    const cost = costOf(h);
    const maxed = lv>=h.max;
    const can = state.score>=cost && !maxed;
    html += `
      <div class="heroCard ${!can&&!maxed?'disabled':''} ${maxed?'maxed':''}" data-buy="${h.key}" style="--accent:${h.accent};--accent-soft:${h.accentSoft}">
        <div class="hIcon">${h.icon}</div>
        <div class="hName">${h.name}</div>
        <div class="hDesc">${h.desc(lv)}</div>
        <div class="hFooter"><span class="hLvl">LV ${lv}</span><span class="hPrice">${maxed?'✓ MAX':'⬤ '+fmt(cost)}</span></div>
      </div>`;
  }
  html += '</div>';
  sheetBody.innerHTML = html;
  sheetBody.querySelectorAll('[data-buy]').forEach(c=>{ c.onclick = ()=> buyHero(c.dataset.buy); });
}
function buyHero(key){
  const h = HEROES.find(x=>x.key===key);
  const lv = state.upgrades[key]||0;
  if(lv>=h.max){ showToast('MAX LEVEL REACHED'); SFX.err(); return; }
  const cost = costOf(h);
  if(state.score<cost){ showToast('NOT ENOUGH CREDITS'); SFX.err(); return; }
  state.score -= cost; state.upgrades[key] = lv+1;
  state.stats.todayUpgrades = (state.stats.todayUpgrades||0) + 1;
  state.stats.weekUpgrades = (state.stats.weekUpgrades||0) + 1;
  if(key==='miner') state.perClick += 1;
  if(key==='reactor') state.energyMax += 500;
  if(key==='vibranium') state.regen += 2;
  SFX.buy(); showToast('◆ '+h.name.toUpperCase()+' UPGRADED', true);
  saveState(); render(); renderShop();
}

/* MISSIONS */
let currentMissionTab = 'daily';
function renderMissions(){
  const tabs = `
    <div class="subTabs">
      <div class="subTab ${currentMissionTab==='daily'?'active':''}" data-mtab="daily">Daily</div>
      <div class="subTab ${currentMissionTab==='weekly'?'active':''}" data-mtab="weekly">Weekly</div>
      <div class="subTab ${currentMissionTab==='streak'?'active':''}" data-mtab="streak">Streak</div>
    </div>`;
  let content = '';
  if(currentMissionTab === 'streak'){ content = renderStreakView(); }
  else {
    const list = currentMissionTab === 'daily' ? DAILY_MISSIONS : WEEKLY_MISSIONS;
    const storage = currentMissionTab === 'daily' ? state.daily : state.weekly;
    for(const m of list){
      const p = Math.min(m.prog(state), m.need);
      const done = p>=m.need;
      const claimed = storage[m.id]==='claimed';
      const pct = (p/m.need)*100;
      const rewardTxt = m.goldReward ? `${fmt(m.reward)}🪙+${m.goldReward}💰` : `${fmt(m.reward)}🪙`;
      content += `
        <div class="missionCard ${done?'done':''}">
          <div class="mIcon">${m.icon}</div>
          <div class="mBody">
            <div class="mTitle">${m.title}</div>
            <div class="mDesc">${m.desc} — ${fmt(p)} / ${fmt(m.need)}</div>
            <div class="mBar"><div class="mFill" style="width:${pct}%"></div></div>
          </div>
          ${done && !claimed ? `<button class="mClaim" data-claim="${m.id}" data-type="${currentMissionTab}">${rewardTxt}</button>` : ''}
          ${claimed ? '<div style="color:#4CDC6E;font-size:9px;font-weight:800;letter-spacing:1px">✓</div>' : ''}
        </div>`;
    }
  }
  sheetBody.innerHTML = tabs + content;
  sheetBody.querySelectorAll('[data-mtab]').forEach(t=>{ t.onclick = ()=>{ currentMissionTab = t.dataset.mtab; renderMissions(); }; });
  sheetBody.querySelectorAll('[data-claim]').forEach(b=>{ b.onclick = ()=> claimMission(b.dataset.claim, b.dataset.type); });
  const sb = document.getElementById('streakBtn'); if(sb) sb.onclick = claimStreak;
}
function claimMission(id, type){
  const list = type === 'daily' ? DAILY_MISSIONS : WEEKLY_MISSIONS;
  const storage = type === 'daily' ? state.daily : state.weekly;
  const m = list.find(x=>x.id===id); if(!m) return;
  if(storage[id] === 'claimed') return;
  state.score += m.reward;
  if(m.goldReward) state.gold = (state.gold||0) + m.goldReward;
  storage[id] = 'claimed';
  SFX.claim();
  const msg = m.goldReward ? `◆ +${fmt(m.reward)}🪙 +${m.goldReward}💰` : `◆ +${fmt(m.reward)}🪙`;
  showToast(msg, true);
  saveState(); render(); renderMissions();
}
function renderStreakView(){
  const claimed = (Date.now() - state.lastStreakClaim) < 24*3600*1000;
  const streak = state.streak || 0;
  const mult = 1 + Math.min(streak, 7) * 0.15;
  const todayReward = Math.floor(100 * mult);
  const goldReward = streak >= 7 ? 2 : (streak >= 3 ? 1 : 0);
  let dots = '';
  for(let i=0;i<7;i++){
    const done = i < streak;
    const isToday = i === streak && !claimed;
    dots += `<div class="streakDot ${done?'done':''} ${isToday?'today':''}">${done?'✓':i+1}</div>`;
  }
  return `
    <div class="streakCard">
      <div class="scTitle">🔥 Daily Streak</div>
      <div class="scDays">${streak}</div>
      <div class="scLabel">consecutive days</div>
      <div class="scMult">REWARD ×${mult.toFixed(2)}</div>
      <div class="streakDots">${dots}</div>
      <button class="streakBtn" id="streakBtn" ${claimed?'disabled':''}>${claimed?'COME BACK TOMORROW':`CLAIM +${fmt(todayReward)}🪙${goldReward?' +'+goldReward+'💰':''}`}</button>
    </div>`;
}
function claimStreak(){
  const now = Date.now();
  if(now - state.lastStreakClaim < 24*3600*1000) return;
  if(now - state.lastStreakClaim > 48*3600*1000) state.streak = 0;
  state.streak = (state.streak||0) + 1;
  const mult = 1 + Math.min(state.streak-1, 7) * 0.15;
  const reward = Math.floor(100 * mult);
  const goldReward = state.streak >= 7 ? 2 : (state.streak >= 3 ? 1 : 0);
  state.score += reward;
  if(goldReward) state.gold = (state.gold||0) + goldReward;
  state.lastStreakClaim = now;
  SFX.claim();
  const sub = goldReward ? 'multiplier ×' + mult.toFixed(2) + ' · +' + goldReward + '💰' : 'multiplier ×' + mult.toFixed(2);
  popReward('🔥', 'STREAK DAY ' + state.streak, '+' + fmt(reward), sub);
  saveState(); render(); renderMissions();
}

