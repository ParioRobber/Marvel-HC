/* AUDIO */
let actx = null;
function ensureAudio(){ if(!actx){ try{ actx = new (window.AudioContext||window.webkitAudioContext)(); }catch{} } if(actx && actx.state==='suspended') actx.resume(); }
function tone(f, d=0.06, t='sine', v=0.05, delay=0){ if(!actx) return; try{ const s = actx.currentTime + delay; const o = actx.createOscillator(); const g = actx.createGain(); o.type=t; o.frequency.setValueAtTime(f, s); g.gain.setValueAtTime(v, s); g.gain.exponentialRampToValueAtTime(0.0001, s+d); o.connect(g); g.connect(actx.destination); o.start(s); o.stop(s+d); }catch{} }
function punch(f, d=0.08, v=0.08){ if(!actx) return; try{ const s = actx.currentTime; const o = actx.createOscillator(); const g = actx.createGain(); o.type='triangle'; o.frequency.setValueAtTime(f, s); o.frequency.exponentialRampToValueAtTime(f*0.4, s+d); g.gain.setValueAtTime(v, s); g.gain.exponentialRampToValueAtTime(0.0001, s+d); o.connect(g); g.connect(actx.destination); o.start(s); o.stop(s+d); }catch{} }
function noiseBurst(dur=0.15, vol=0.06){ if(!actx) return; try{ const t = actx.currentTime; const b = actx.createBuffer(1, actx.sampleRate*dur, actx.sampleRate); const d = b.getChannelData(0); for(let i=0;i<d.length;i++) d[i] = (Math.random()*2-1) * Math.pow(1-i/d.length, 2); const s = actx.createBufferSource(); s.buffer = b; const g = actx.createGain(); g.gain.value = vol; s.connect(g); g.connect(actx.destination); s.start(t); }catch{} }
const SFX = {
  tap(c){ const b = 700 + Math.min(c*30, 600); punch(b,.06,.06); tone(b*1.5,.04,'sine',.025); },
  crit(){ punch(400,.12,.12); tone(1200,.1,'sawtooth',.05); tone(1800,.14,'sine',.04,.06); },
  mega(){ punch(300,.15,.14); tone(880,.12,'sawtooth',.06); tone(1320,.14,'sawtooth',.05,.08); tone(1760,.2,'sine',.05,.16); noiseBurst(.25,.08); },
  err(){ tone(160,.15,'sawtooth',.05); tone(100,.2,'sawtooth',.04,.05); },
  buy(){ tone(880,.06,'sine',.06); tone(1320,.08,'sine',.05,.06); },
  claim(){ tone(1046,.08,'sine',.06); tone(1568,.1,'sine',.05,.08); tone(2093,.14,'sine',.05,.16); },
  achv(){ [1318,1760,2093].forEach((f,i)=>tone(f,.12,'triangle',.06,i*.09)); noiseBurst(.2,.05); },
  login(){ [659,880,1046].forEach((f,i)=>tone(f,.15,'sine',.06,i*.08)); },
};

