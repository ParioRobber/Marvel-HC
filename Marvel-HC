<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#000">
<title>Marvels : Hard Comeback</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
html,body{height:100%;overflow:hidden;overscroll-behavior:none;background:#000}
body{
  font-family:'Inter',sans-serif;color:#fff;
  display:flex;justify-content:center;align-items:center;
  position:relative;overflow:hidden;
  font-feature-settings:"tnum" on,"lnum" on;
  -webkit-font-smoothing:antialiased;letter-spacing:-0.01em;perspective:1400px;
}

/* AUTH */
.authOverlay{position:fixed;inset:0;z-index:10000;background:#050208;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;visibility:hidden;transition:opacity .4s,visibility .4s}
.authOverlay.show{opacity:1;visibility:visible}
.authBg{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%, rgba(230,36,41,.4), transparent 55%),radial-gradient(ellipse at 20% 100%, rgba(255,184,0,.15), transparent 55%),linear-gradient(180deg,#1a0207 0%,#0a0205 50%,#000 100%)}
.authBg::before{content:'';position:absolute;inset:0;background-image:radial-gradient(circle, rgba(255,255,255,.06) 1px, transparent 1.4px);background-size:34px 34px;mask-image:radial-gradient(ellipse at 50% 40%, #000 20%, transparent 80%);-webkit-mask-image:radial-gradient(ellipse at 50% 40%, #000 20%, transparent 80%);opacity:.5}
.authCard{position:relative;z-index:2;width:100%;max-width:400px;background:linear-gradient(160deg,rgba(30,30,40,.85),rgba(12,12,20,.95));border:1px solid rgba(230,36,41,.3);border-radius:24px;padding:32px 26px 24px;box-shadow:0 30px 80px rgba(0,0,0,.9),0 0 60px rgba(230,36,41,.25);backdrop-filter:blur(20px);transform:translateY(30px) scale(.95);transition:.5s cubic-bezier(.2,.9,.3,1)}
.authOverlay.show .authCard{transform:translateY(0) scale(1)}
.authLogo{width:64px;height:64px;margin:0 auto 14px;background:linear-gradient(135deg,#E62429,#8B0F14);border-radius:14px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:32px;box-shadow:0 0 40px rgba(230,36,41,.7),inset 0 2px 0 rgba(255,255,255,.3);position:relative;overflow:hidden}
.authLogo::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:linear-gradient(45deg,transparent,rgba(255,255,255,.4),transparent);animation:logoShine 3s ease-in-out infinite}
@keyframes logoShine{0%{transform:translateX(-100%) rotate(45deg)}100%{transform:translateX(100%) rotate(45deg)}}
.authCard h1{font-family:'Rajdhani',sans-serif;font-size:26px;font-weight:900;text-align:center;letter-spacing:3px;margin-bottom:6px;text-shadow:0 0 25px rgba(230,36,41,.6)}
.authSub{text-align:center;font-size:11.5px;color:#8a8a95;margin-bottom:24px;line-height:1.6}
.authTabs{display:flex;gap:6px;margin-bottom:18px;background:rgba(0,0,0,.4);padding:4px;border-radius:12px;border:1px solid rgba(255,255,255,.05)}
.authTab{flex:1;padding:11px;text-align:center;border-radius:9px;font-size:11px;font-weight:800;color:#7a7a85;cursor:pointer;transition:.2s;font-family:'Rajdhani',sans-serif;letter-spacing:2px;text-transform:uppercase}
.authTab.active{background:linear-gradient(135deg,#E62429,#8B0F14);color:#fff;box-shadow:0 0 20px rgba(230,36,41,.5),inset 0 1px 0 rgba(255,255,255,.15)}
.authInput{width:100%;padding:14px 16px;background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:#fff;font-size:14px;letter-spacing:.5px;margin-bottom:12px;outline:none;transition:.2s;-webkit-user-select:text;user-select:text;font-family:'Inter',sans-serif}
.authInput::placeholder{color:#5a5a65;letter-spacing:1px;font-size:12px}
.authInput:focus{border-color:#E62429;box-shadow:0 0 20px rgba(230,36,41,.3);background:rgba(0,0,0,.6)}
.authBtn{width:100%;padding:15px;border:none;background:linear-gradient(135deg,#E62429,#8B0F14);color:#fff;font-weight:900;font-size:13px;font-family:'Rajdhani',sans-serif;letter-spacing:3px;text-transform:uppercase;border-radius:12px;cursor:pointer;box-shadow:0 4px 0 rgba(90,10,15,.7),0 6px 25px rgba(230,36,41,.5);transition:.15s;margin-top:4px}
.authBtn:active{transform:translateY(2px);box-shadow:0 2px 0 rgba(90,10,15,.7)}
.authMsg{text-align:center;font-size:11.5px;font-weight:700;min-height:18px;margin-top:12px;letter-spacing:.5px}
.authMsg.error{color:#FF3B42}
.authMsg.success{color:#4CDC6E}
.authSkip{text-align:center;font-size:11px;color:#5a5a65;margin-top:18px;letter-spacing:1px}
.authSkip span{color:#FFB800;cursor:pointer;font-weight:800;text-decoration:underline;text-underline-offset:3px}
.authHint{font-size:10px;color:#5a5a65;text-align:center;margin-top:8px;line-height:1.6}

/* INTRO */
#intro{position:fixed;inset:0;z-index:9999;background:#0a0000;display:flex;align-items:center;justify-content:center;overflow:hidden;transition:opacity 1s,visibility 1s}
#intro.hide{opacity:0;visibility:hidden}
.marvel-bg{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%, #C41E22 0%, #8B0F14 45%, #4A0508 80%, #1a0203 100%);opacity:0;animation:fadeInScale 1.6s cubic-bezier(.2,.9,.3,1) .2s forwards}
@keyframes fadeInScale{from{opacity:0;transform:scale(1.15)}to{opacity:1;transform:scale(1)}}
.marvel-bg::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(-18deg, transparent 0, transparent 60px, rgba(0,0,0,.15) 60px, rgba(0,0,0,.15) 61px, transparent 61px, transparent 200px);opacity:.6;mix-blend-mode:multiply}
.marvel-bg::after{content:'';position:absolute;inset:0;background-image:radial-gradient(circle at 15% 25%, rgba(255,255,255,.06) 1px, transparent 1.5px),radial-gradient(circle at 70% 80%, rgba(255,255,255,.05) 1px, transparent 1.5px);background-size:24px 24px, 30px 30px;opacity:.5}
.marvel-ghost{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:900;font-size:min(30vw, 220px);letter-spacing:-.05em;color:transparent;-webkit-text-stroke:2px rgba(0,0,0,.35);opacity:0;animation:ghostFade 1.4s ease-out 1s forwards;white-space:nowrap;z-index:1}
@keyframes ghostFade{from{opacity:0;transform:translate(-50%,-50%) scale(1.2)}to{opacity:.6;transform:translate(-50%,-50%) scale(1)}}
.marvel-box{position:relative;z-index:2;background:#fff;padding:clamp(10px, 2vw, 22px) clamp(28px, 6vw, 70px);border:3px solid #fff;opacity:0;animation:boxSlide 1.2s cubic-bezier(.2,.9,.3,1) .6s forwards;box-shadow:0 0 80px rgba(255,255,255,.3),0 20px 60px rgba(0,0,0,.5)}
@keyframes boxSlide{from{opacity:0;transform:scale(.6) translateY(40px)}to{opacity:1;transform:scale(1) translateY(0)}}
.marvel-box span{font-weight:900;font-size:clamp(32px, 8vw, 90px);letter-spacing:-.02em;display:block;line-height:1;background:linear-gradient(180deg,#000 0%, #2a2a2a 50%, #000 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.marvel-credit{position:absolute;bottom:12%;left:50%;transform:translateX(-50%);font-family:'Rajdhani',sans-serif;font-size:clamp(11px, 1.5vw, 14px);letter-spacing:6px;color:rgba(255,255,255,.85);text-transform:uppercase;opacity:0;animation:creditFade 1.2s ease-out 1.8s forwards;z-index:3;text-align:center}
@keyframes creditFade{from{opacity:0;letter-spacing:14px}to{opacity:1;letter-spacing:6px}}
.marvel-credit b{display:block;font-weight:700;color:#fff;font-size:1.4em;margin-top:4px;letter-spacing:8px;text-shadow:0 0 25px rgba(255,255,255,.6)}
.intro-loading{position:absolute;bottom:6%;left:50%;transform:translateX(-50%);width:min(260px, 60vw);height:3px;background:rgba(255,255,255,.15);border-radius:99px;overflow:hidden;z-index:3;opacity:0;animation:creditFade 1s ease-out 2.2s forwards}
.intro-loading .fill{height:100%;width:0;background:linear-gradient(90deg,#fff,#FFB800,#fff);animation:loadFill 2s cubic-bezier(.4,.2,.2,1) 2.4s forwards;box-shadow:0 0 15px rgba(255,255,255,.9)}
@keyframes loadFill{to{width:100%}}
.intro-skip{position:absolute;bottom:24px;right:24px;font-family:'Rajdhani',sans-serif;font-size:12px;letter-spacing:3px;color:rgba(255,255,255,.55);cursor:pointer;z-index:4;border:1px solid rgba(255,255,255,.2);padding:8px 16px;border-radius:99px;backdrop-filter:blur(8px);transition:.3s;animation:skipBlink 1.5s ease-in-out infinite}
.intro-skip:hover{background:rgba(255,255,255,.1);color:#fff}
@keyframes skipBlink{0%,100%{opacity:.6}50%{opacity:1}}

/* UPDATE POPUP */
.updateOverlay{position:fixed;inset:0;z-index:9000;background:rgba(0,0,0,.85);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:.4s}
.updateOverlay.show{opacity:1;pointer-events:auto}
.updateCard{background:linear-gradient(160deg,#1a1a24,#0d0d15);border:1px solid rgba(230,36,41,.4);border-radius:24px;max-width:420px;width:100%;padding:28px 24px 22px;position:relative;overflow:hidden;box-shadow:0 30px 100px rgba(0,0,0,.9),0 0 60px rgba(230,36,41,.3);transform:translateY(30px) scale(.95);transition:.5s cubic-bezier(.2,.9,.3,1);max-height:85vh;display:flex;flex-direction:column}
.updateOverlay.show .updateCard{transform:translateY(0) scale(1)}
.updateCard::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#E62429,#FFB800,#E62429,transparent);box-shadow:0 0 20px rgba(230,36,41,.8)}
.updateHeader{display:flex;align-items:center;gap:12px;margin-bottom:18px}
.updateIcon{width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#E62429,#8B0F14);display:flex;align-items:center;justify-content:center;font-size:26px;box-shadow:0 0 25px rgba(230,36,41,.6),inset 0 2px 0 rgba(255,255,255,.2);flex-shrink:0}
.updateTitle h2{font-size:19px;font-weight:900;font-family:'Rajdhani',sans-serif;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:3px}
.updateTitle .ver{font-size:11px;color:#FFB800;font-weight:800;letter-spacing:2px;font-family:'Rajdhani',sans-serif}
.updateBody{color:#c8c8d0;font-size:13px;line-height:1.7;margin-bottom:20px;overflow-y:auto;flex:1;padding-right:4px}
.updateBody::-webkit-scrollbar{width:4px}
.updateBody::-webkit-scrollbar-thumb{background:rgba(230,36,41,.5);border-radius:99px}
.updateBody h3{font-size:12px;color:#E62429;font-weight:800;letter-spacing:2px;text-transform:uppercase;margin:16px 0 8px;display:flex;align-items:center;gap:6px}
.updateBody h3:first-child{margin-top:0}
.updateBody h3::before{content:'';width:3px;height:12px;background:#E62429;border-radius:2px;box-shadow:0 0 10px rgba(230,36,41,.8)}
.updateBody ul{list-style:none}
.updateBody li{padding:6px 0 6px 22px;position:relative;font-size:12.5px;color:#b8b8c0}
.updateBody li::before{content:'▸';position:absolute;left:4px;top:6px;color:#FFB800;font-weight:900}
.updateBody li b{color:#fff;font-weight:700}
.updateBtn{width:100%;padding:14px;border:none;background:linear-gradient(135deg,#E62429,#8B0F14);color:#fff;font-weight:900;font-size:13px;font-family:'Rajdhani',sans-serif;letter-spacing:2px;text-transform:uppercase;border-radius:14px;cursor:pointer;box-shadow:0 4px 0 rgba(90,10,15,.7),0 6px 25px rgba(230,36,41,.5);transition:.15s;flex-shrink:0}
.updateBtn:active{transform:translateY(2px);box-shadow:0 2px 0 rgba(90,10,15,.7)}
.updateBtn.ghost{background:rgba(255,255,255,.06);color:#fff;border:1px solid rgba(255,255,255,.12);box-shadow:none;margin-top:8px;font-size:11.5px}

/* BACKGROUND */
#bgStage{position:fixed;inset:-8%;z-index:0;pointer-events:none;transition:transform .35s cubic-bezier(.2,.9,.3,1)}
.bg-layer{position:absolute;inset:0;will-change:transform}
.bg-base{background:radial-gradient(ellipse at 50% -10%, rgba(230,36,41,.5) 0%, transparent 55%),radial-gradient(ellipse at 20% 110%, rgba(255,184,0,.18) 0%, transparent 55%),radial-gradient(ellipse at 85% 90%, rgba(230,36,41,.25) 0%, transparent 50%),linear-gradient(180deg,#0a0a12 0%,#05050a 40%,#000 100%)}
.bg-dots{opacity:.4;background-image:radial-gradient(circle, rgba(255,255,255,.09) 1px, transparent 1.4px);background-size:34px 34px;mask-image:radial-gradient(ellipse at 50% 40%, #000 20%, transparent 80%);-webkit-mask-image:radial-gradient(ellipse at 50% 40%, #000 20%, transparent 80%)}
.bg-grid{opacity:.14;background-image:linear-gradient(rgba(230,36,41,.4) 1px, transparent 1px),linear-gradient(90deg, rgba(230,36,41,.4) 1px, transparent 1px);background-size:64px 64px;mask-image:radial-gradient(ellipse at 50% 60%, #000 20%, transparent 80%);-webkit-mask-image:radial-gradient(ellipse at 50% 60%, #000 20%, transparent 80%)}
.bg-vignette{background:radial-gradient(ellipse at 50% 50%, transparent 30%, rgba(0,0,0,.9) 100%)}
.bg-streak{background:linear-gradient(90deg,transparent,rgba(230,36,41,.16),transparent);transform:skewX(-20deg);animation:streakMove 9s linear infinite;width:80%;height:100%;left:-40%;opacity:.75;position:absolute}
@keyframes streakMove{0%{left:-60%}100%{left:120%}}
.dust{position:absolute;width:2px;height:2px;border-radius:50%;background:rgba(255,184,0,.7);box-shadow:0 0 8px rgba(255,184,0,.9);pointer-events:none;animation:dustFloat linear infinite}
@keyframes dustFloat{0%{transform:translateY(0);opacity:0}10%{opacity:.8}90%{opacity:.8}100%{transform:translateY(-120vh);opacity:0}}
#dynLight{position:fixed;width:700px;height:700px;border-radius:50%;pointer-events:none;z-index:1;background:radial-gradient(circle, rgba(230,36,41,.28) 0%, rgba(230,36,41,.08) 25%, transparent 55%);transform:translate(-50%,-50%);transition:transform .15s ease-out;filter:blur(30px);mix-blend-mode:screen}

/* APP */
#app{position:relative;z-index:5;width:100%;max-width:440px;height:100%;max-height:900px;display:flex;flex-direction:column;overflow:hidden}
#app.shake{animation:screenShake .32s cubic-bezier(.36,.07,.19,.97)}
@keyframes screenShake{10%,90%{transform:translate(-2px,0)}20%,80%{transform:translate(3px,0)}30%,50%,70%{transform:translate(-4px,1px)}40%,60%{transform:translate(4px,-1px)}}

/* HEADER */
header{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 8px;gap:8px;z-index:10}
.logo{display:flex;align-items:center;gap:9px}
.logoBox{width:32px;height:32px;background:linear-gradient(135deg,#E62429,#8B0F14);border-radius:7px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:17px;box-shadow:0 0 25px rgba(230,36,41,.7),inset 0 1px 0 rgba(255,255,255,.35);position:relative;overflow:hidden;flex-shrink:0}
.logoBox::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:linear-gradient(45deg,transparent,rgba(255,255,255,.4),transparent);animation:logoShine 3s ease-in-out infinite}
.logo .name{display:flex;flex-direction:column;gap:1px;min-width:0}
.logo .name .n1{color:#fff;font-size:12px;letter-spacing:2px;font-weight:800;font-family:'Rajdhani',sans-serif}
.logo .name .n1 b{color:#E62429;font-weight:900}
.logo .name .n2{color:#8a8a95;font-size:8.5px;letter-spacing:1.5px;font-weight:700;font-family:'Rajdhani',sans-serif;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:120px}
.logo .name .n2 b{color:#FFB800}
.headerRight{display:flex;gap:6px;align-items:center}
.rankBadge{display:flex;align-items:center;gap:5px;background:linear-gradient(135deg,rgba(255,184,0,.12),rgba(255,184,0,.03));border:1px solid rgba(255,184,0,.35);padding:6px 10px;border-radius:99px;font-size:9.5px;font-weight:800;color:#FFB800;letter-spacing:1.2px;font-family:'Rajdhani',sans-serif;backdrop-filter:blur(8px)}
.rankBadge .dot{width:6px;height:6px;border-radius:50%;background:#FFB800;box-shadow:0 0 10px #FFB800;animation:pulseDot 1.6s ease-in-out infinite}
@keyframes pulseDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
.hIconBtn{width:34px;height:34px;border-radius:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:15px;color:#fff;transition:.2s;backdrop-filter:blur(8px)}
.hIconBtn:active{transform:scale(.92);background:rgba(230,36,41,.2)}

/* SCORE */
.scoreBox{text-align:center;padding:6px 20px 0;z-index:5}
.scoreLabel{font-size:10px;color:#8a8a95;letter-spacing:4px;font-weight:700;margin-bottom:6px;font-family:'Rajdhani',sans-serif;text-shadow:0 0 10px rgba(230,36,41,.3)}
.balance{display:inline-flex;align-items:center;justify-content:center;gap:14px;padding:2px 0}
.balance .coinMini{width:38px;height:38px;filter:drop-shadow(0 0 18px rgba(255,184,0,.85));animation:coinFloat 3s ease-in-out infinite}
@keyframes coinFloat{0%,100%{transform:translateY(0) rotateY(0)}50%{transform:translateY(-3px) rotateY(25deg)}}
.balance .amount{font-size:54px;font-weight:900;line-height:1;color:#fff;letter-spacing:-2px;font-variant-numeric:tabular-nums;text-shadow:0 0 30px rgba(255,184,0,.55),0 2px 22px rgba(230,36,41,.45);transition:transform .1s,color .15s}
.balance .amount.pop{transform:scale(1.09);color:#FFB800}
.miniRow{display:flex;gap:8px;justify-content:center;margin-top:8px;padding:0 20px}
.miniPill{display:inline-flex;align-items:center;gap:5px;background:linear-gradient(135deg, rgba(0,0,0,.5), rgba(0,0,0,.3));border:1px solid rgba(255,255,255,.1);padding:4px 10px;border-radius:99px;font-size:11px;font-weight:800;font-variant-numeric:tabular-nums;backdrop-filter:blur(8px);transition:.2s}
.miniPill .ico{font-size:12px;line-height:1}
.miniPill.gold{background:linear-gradient(135deg, rgba(255,184,0,.18), rgba(255,184,0,.04));border-color:rgba(255,184,0,.45);color:#FFB800;box-shadow:0 0 15px rgba(255,184,0,.2)}
.miniPill.gold b{color:#fff}
.miniPill.miner{background:linear-gradient(135deg, rgba(76,220,110,.18), rgba(76,220,110,.04));border-color:rgba(76,220,110,.45);color:#4CDC6E;box-shadow:0 0 15px rgba(76,220,110,.2)}
.miniPill.miner b{color:#fff}
.perClick{font-size:11px;color:#8a8a95;margin-top:8px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:6px}
.perClick b{color:#E62429;font-weight:800;letter-spacing:.5px;text-shadow:0 0 10px rgba(230,36,41,.5)}
.perClick .divider{color:#5a5a65;margin:0 4px}

/* COIN */
.coinArea{flex:1;position:relative;display:flex;align-items:center;justify-content:center;z-index:5;overflow:hidden;min-height:0;padding:10px 0;perspective:1000px}
.hexGrid{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none}
.hexRing{position:absolute;border-radius:50%}
.hexRing.r1{width:290px;height:290px;border:1px solid rgba(230,36,41,.5);box-shadow:0 0 45px rgba(230,36,41,.3),inset 0 0 45px rgba(230,36,41,.18);animation:ringRotate 25s linear infinite}
.hexRing.r1::before{content:'';position:absolute;top:0;left:50%;transform:translate(-50%,-50%);width:10px;height:10px;border-radius:50%;background:#E62429;box-shadow:0 0 20px #E62429}
.hexRing.r1::after{content:'';position:absolute;bottom:0;left:50%;transform:translate(-50%,50%);width:8px;height:8px;border-radius:50%;background:#FFB800;box-shadow:0 0 20px #FFB800}
.hexRing.r2{width:348px;height:348px;border:1px dashed rgba(255,184,0,.32);animation:ringRotate 40s linear infinite reverse}
.hexRing.r3{width:398px;height:398px;border:1px dotted rgba(230,36,41,.22);animation:ringRotate 70s linear infinite}
.hexRing.r4{width:445px;height:445px;border:1px solid rgba(255,184,0,.1);animation:ringRotate 90s linear infinite reverse}
@keyframes ringRotate{to{transform:rotate(360deg)}}
.bracket{position:absolute;width:30px;height:30px;border:2px solid #E62429;pointer-events:none;box-shadow:0 0 15px rgba(230,36,41,.6);animation:bracketPulse 2.4s ease-in-out infinite}
@keyframes bracketPulse{0%,100%{opacity:.9}50%{opacity:.4}}
.bracket.tl{top:20px;left:20px;border-right:none;border-bottom:none}
.bracket.tr{top:20px;right:20px;border-left:none;border-bottom:none}
.bracket.bl{bottom:20px;left:20px;border-right:none;border-top:none}
.bracket.br{bottom:20px;right:20px;border-left:none;border-top:none}
.coinGlow{position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle, rgba(255,184,0,.55) 0%, rgba(255,184,0,.22) 22%, rgba(230,36,41,.14) 45%, transparent 70%);animation:glowPulse 2.8s ease-in-out infinite;pointer-events:none;filter:blur(14px)}
@keyframes glowPulse{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.2);opacity:1}}
#coin{width:250px;height:250px;position:relative;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .08s cubic-bezier(.3,1.6,.6,1);animation:coinIdle 3.5s ease-in-out infinite;filter:drop-shadow(0 25px 50px rgba(0,0,0,.9)) drop-shadow(0 0 70px rgba(255,184,0,.65)) drop-shadow(0 0 140px rgba(230,36,41,.45));touch-action:manipulation}
@keyframes coinIdle{0%,100%{transform:translateY(0) rotateY(0)}50%{transform:translateY(-10px) rotateY(8deg)}}
#coin:active,#coin.hit{transform:scale(.92) translateY(-4px)}
#coin svg{width:100%;height:100%;display:block;pointer-events:none}
.orbit{position:absolute;inset:0;pointer-events:none;z-index:-1}
.orbitDot{position:absolute;width:7px;height:7px;border-radius:50%;background:#FFB800;box-shadow:0 0 14px #FFB800;top:50%;left:50%;animation:orbit 6s linear infinite}
@keyframes orbit{from{transform:rotate(0deg) translateX(158px) rotate(0deg)}to{transform:rotate(360deg) translateX(158px) rotate(-360deg)}}
.comboBadge{position:absolute;top:14px;left:50%;transform:translateX(-50%) translateY(-20px);font-family:'Rajdhani',sans-serif;font-weight:800;font-size:26px;color:#FFB800;text-shadow:0 0 30px rgba(255,184,0,.9),0 0 60px rgba(230,36,41,.5);opacity:0;transition:.2s;pointer-events:none;z-index:80;letter-spacing:4px;text-transform:uppercase}
.comboBadge.show{opacity:1;transform:translateX(-50%) translateY(0);animation:comboPop .3s ease}
.comboBadge.x2{color:#fff}
.comboBadge.x3{color:#E62429}
.comboBadge.x4{color:#FFB800;text-shadow:0 0 40px #FFB800,0 0 80px #E62429,0 0 120px #FFB800}
@keyframes comboPop{0%{transform:translateX(-50%) translateY(0) scale(1.8);opacity:0}100%{transform:translateX(-50%) translateY(0) scale(1);opacity:1}}
.comboEdge{position:fixed;inset:0;pointer-events:none;z-index:80;opacity:0;transition:opacity .3s;background:radial-gradient(ellipse at top, rgba(230,36,41,.4), transparent 40%),radial-gradient(ellipse at bottom, rgba(255,184,0,.3), transparent 40%)}
.comboEdge.show{opacity:1}
.hint{position:absolute;bottom:-30px;left:50%;transform:translateX(-50%);font-size:10px;color:#8a8a95;letter-spacing:3px;font-weight:700;font-family:'Rajdhani',sans-serif;text-transform:uppercase;animation:hintPulse 2.4s ease-in-out infinite;white-space:nowrap;pointer-events:none}
@keyframes hintPulse{0%,100%{opacity:.4}50%{opacity:1}}

/* ENERGY */
.energyBox{padding:10px 22px 12px;z-index:5}
.energyRow{display:flex;align-items:center;gap:10px}
.energyIcon{width:20px;height:20px;display:flex;align-items:center;justify-content:center;color:#FFB800;filter:drop-shadow(0 0 12px rgba(255,184,0,1));animation:energyPulse 1.5s ease-in-out infinite}
@keyframes energyPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.2)}}
.energyText{font-size:10.5px;color:#8a8a95;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap;min-width:78px;text-align:left;letter-spacing:.5px;font-family:'Rajdhani',sans-serif}
.energyText b{color:#fff;font-weight:800}
.energyBar{flex:1;height:15px;background:rgba(255,255,255,.04);border-radius:99px;overflow:hidden;border:1px solid rgba(255,184,0,.32);position:relative;box-shadow:inset 0 2px 10px rgba(0,0,0,.5)}
.energyBar::before{content:'';position:absolute;inset:0;background-image:repeating-linear-gradient(90deg, transparent 0 18px, rgba(0,0,0,.4) 18px 19px);z-index:2;pointer-events:none;opacity:.35}
.energyFill{height:100%;width:100%;position:relative;background:linear-gradient(90deg,#8B0F14,#E62429,#FF4B52,#FFB800,#FFE27A);background-size:250% 100%;border-radius:99px;box-shadow:0 0 25px rgba(230,36,41,.9),inset 0 1px 0 rgba(255,255,255,.45);transition:width .25s linear;animation:energyFlow 3s linear infinite}
@keyframes energyFlow{0%{background-position:0% 0}100%{background-position:250% 0}}
.energyFill.low{background:linear-gradient(90deg,#5a0000,#8B0F14);box-shadow:0 0 25px rgba(139,15,20,.9);animation:energyFlow 3s linear infinite,lowPulse .8s ease-in-out infinite}
@keyframes lowPulse{0%,100%{opacity:1}50%{opacity:.5}}

/* NAV */
.bottomNav{display:flex;justify-content:space-around;align-items:center;padding:10px 4px calc(12px + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(10,5,8,.7),rgba(5,2,4,.98));border-top:1px solid rgba(230,36,41,.25);backdrop-filter:blur(20px);z-index:20;position:relative;box-shadow:0 -12px 45px rgba(0,0,0,.5),inset 0 1px 0 rgba(230,36,41,.1)}
.navItem{display:flex;flex-direction:column;align-items:center;gap:4px;flex:1;padding:6px 2px;border-radius:14px;cursor:pointer;transition:.2s;color:#5a5a65;font-size:9.5px;font-weight:700;letter-spacing:1px;font-family:'Rajdhani',sans-serif;text-transform:uppercase}
.navItem .navIcon{font-size:19px;line-height:1;transition:.2s;filter:grayscale(.7) opacity(.55);position:relative}
.navItem.active{color:#E62429;background:radial-gradient(circle at center, rgba(230,36,41,.2), transparent 70%)}
.navItem.active .navIcon{filter:drop-shadow(0 0 12px rgba(230,36,41,1)) grayscale(0) opacity(1);transform:scale(1.15)}
.navBadge{position:absolute;top:-3px;right:-6px;min-width:15px;height:15px;padding:0 4px;background:#E62429;color:#fff;border-radius:99px;font-size:8px;font-weight:900;display:flex;align-items:center;justify-content:center;border:1.5px solid #000;box-shadow:0 0 10px rgba(230,36,41,.9);animation:badgePulse 1.4s ease-in-out infinite}
@keyframes badgePulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
.navBadge.hidden{display:none}

/* SHEET */
.sheetOverlay{position:absolute;inset:0;background:rgba(0,0,0,.7);z-index:90;opacity:0;pointer-events:none;transition:.3s;backdrop-filter:blur(6px)}
.sheetOverlay.show{opacity:1;pointer-events:auto}
.sheet{position:absolute;bottom:0;left:0;right:0;max-height:82%;background:linear-gradient(180deg,rgba(21,21,28,.98),rgba(10,10,16,.99));border-radius:26px 26px 0 0;border-top:1px solid rgba(230,36,41,.5);box-shadow:0 -30px 90px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.06);z-index:100;transform:translateY(100%);transition:transform .4s cubic-bezier(.2,.9,.3,1);display:flex;flex-direction:column;overflow:hidden;backdrop-filter:blur(20px)}
.sheet.show{transform:translateY(0)}
.sheet::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#E62429,#FFB800,#E62429,transparent);box-shadow:0 0 20px rgba(230,36,41,.7)}
.sheetHeader{display:flex;align-items:center;justify-content:space-between;padding:16px 20px 12px;border-bottom:1px solid rgba(255,255,255,.08);flex-shrink:0;position:relative}
.sheetHeader .dragHandle{position:absolute;top:6px;left:50%;transform:translateX(-50%);width:44px;height:4px;border-radius:99px;background:#5a5a65;opacity:.4}
.sheetTitle{font-size:14px;font-weight:800;color:#fff;display:flex;align-items:center;gap:10px;font-family:'Rajdhani',sans-serif;letter-spacing:2px;text-transform:uppercase}
.sheetTitle .accent{color:#E62429;filter:drop-shadow(0 0 8px rgba(230,36,41,.8))}
.sheetClose{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.06);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;color:#fff;transition:.2s;border:1px solid rgba(255,255,255,.08)}
.sheetClose:active{background:rgba(230,36,41,.25);border-color:rgba(230,36,41,.6)}
.sheetBody{padding:16px 18px 22px;overflow-y:auto;flex:1}
.sheetBody::-webkit-scrollbar{width:0}

/* TABS */
.subTabs{display:flex;gap:6px;margin-bottom:14px;background:rgba(255,255,255,.04);padding:4px;border-radius:12px;border:1px solid rgba(255,255,255,.08)}
.subTab{flex:1;padding:8px;text-align:center;border-radius:9px;font-size:10.5px;font-weight:800;color:#8a8a95;cursor:pointer;transition:.2s;font-family:'Rajdhani',sans-serif;letter-spacing:1px;text-transform:uppercase;position:relative}
.subTab.active{background:linear-gradient(135deg,rgba(230,36,41,.3),rgba(230,36,41,.1));color:#fff;box-shadow:0 0 20px rgba(230,36,41,.35),inset 0 1px 0 rgba(255,255,255,.15)}

/* HERO CARDS */
.heroGrid{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.heroCard{background:linear-gradient(160deg, rgba(30,30,40,.75), rgba(15,15,25,.92));border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:13px 11px;cursor:pointer;transition:.2s cubic-bezier(.2,.9,.3,1);position:relative;overflow:hidden;display:flex;flex-direction:column;gap:9px;box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 4px 20px rgba(0,0,0,.5);backdrop-filter:blur(10px)}
.heroCard::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--accent,#E62429),transparent);opacity:.8;box-shadow:0 0 20px var(--accent,#E62429)}
.heroCard::after{content:'';position:absolute;top:0;left:0;right:0;height:60%;background:radial-gradient(ellipse at 50% 0%, var(--accent-soft,rgba(230,36,41,.15)), transparent 70%);pointer-events:none}
.heroCard:active{transform:scale(.97);border-color:var(--accent,#E62429);box-shadow:0 0 30px var(--accent-soft,rgba(230,36,41,.25)),inset 0 1px 0 rgba(255,255,255,.06)}
.heroCard.disabled{opacity:.5}
.heroCard.maxed{border-color:rgba(255,184,0,.6);box-shadow:0 0 30px rgba(255,184,0,.25),inset 0 1px 0 rgba(255,255,255,.08)}
.heroCard .hIcon{width:52px;height:52px;border-radius:13px;background:linear-gradient(135deg,rgba(255,255,255,.08),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;position:relative;z-index:1;color:var(--accent,#E62429);box-shadow:inset 0 2px 10px rgba(0,0,0,.4),0 0 22px var(--accent-soft,rgba(230,36,41,.15))}
.heroCard .hIcon svg{width:30px;height:30px}
.heroCard .hName{font-size:12.5px;font-weight:800;color:#fff;line-height:1.25;position:relative;z-index:1;font-family:'Rajdhani',sans-serif;letter-spacing:.5px;text-transform:uppercase}
.heroCard .hDesc{font-size:10px;color:#8a8a95;line-height:1.5;position:relative;z-index:1;min-height:30px;font-weight:500}
.heroCard .hFooter{display:flex;align-items:center;justify-content:space-between;margin-top:auto;position:relative;z-index:1;gap:4px}
.heroCard .hLvl{font-size:9px;font-weight:800;color:#8a8a95;background:rgba(255,255,255,.06);padding:3px 8px;border-radius:99px;border:1px solid rgba(255,255,255,.08);font-family:'Rajdhani',sans-serif;letter-spacing:1px}
.heroCard .hPrice{display:inline-flex;align-items:center;gap:3px;background:rgba(255,184,0,.12);border:1px solid rgba(255,184,0,.35);padding:4px 9px;border-radius:99px;font-size:11px;font-weight:800;color:#FFB800;font-variant-numeric:tabular-nums;white-space:nowrap;box-shadow:0 0 15px rgba(255,184,0,.15)}
.heroCard.maxed .hPrice{background:rgba(76,220,110,.15);border-color:rgba(76,220,110,.5);color:#4CDC6E}

/* MISSIONS */
.missionCard{background:linear-gradient(160deg, rgba(30,30,40,.75), rgba(15,15,25,.92));border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:13px;margin-bottom:10px;display:flex;align-items:center;gap:12px;position:relative;overflow:hidden;box-shadow:inset 0 1px 0 rgba(255,255,255,.06);backdrop-filter:blur(8px)}
.missionCard::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:linear-gradient(180deg,#E62429,#FFB800);box-shadow:0 0 15px rgba(230,36,41,.6)}
.missionCard.done::before{background:linear-gradient(180deg,#4CDC6E,#2A8A42);box-shadow:0 0 15px rgba(76,220,110,.7)}
.missionCard.done{border-color:rgba(76,220,110,.4)}
.missionCard .mIcon{width:46px;height:46px;border-radius:12px;background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.02));display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;border:1px solid rgba(255,255,255,.08);box-shadow:inset 0 2px 8px rgba(0,0,0,.3)}
.missionCard .mBody{flex:1;min-width:0}
.missionCard .mTitle{font-size:12.5px;font-weight:800;color:#fff;margin-bottom:4px;font-family:'Rajdhani',sans-serif;letter-spacing:.5px;text-transform:uppercase}
.missionCard .mDesc{font-size:10.5px;color:#8a8a95;line-height:1.5;font-weight:500}
.missionCard .mBar{height:6px;background:rgba(255,255,255,.04);border-radius:99px;margin-top:8px;overflow:hidden;box-shadow:inset 0 1px 4px rgba(0,0,0,.3)}
.missionCard .mFill{height:100%;background:linear-gradient(90deg,#8B0F14,#E62429,#FFB800);border-radius:99px;transition:width .4s;box-shadow:0 0 12px rgba(230,36,41,.8);position:relative;overflow:hidden}
.missionCard .mFill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);animation:shineBar 2s linear infinite}
@keyframes shineBar{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
.missionCard.done .mFill{background:linear-gradient(90deg,#2A8A42,#4CDC6E);box-shadow:0 0 12px rgba(76,220,110,.8)}
.missionCard .mClaim{padding:8px 13px;border-radius:10px;background:linear-gradient(135deg,#E62429,#8B0F14);color:#fff;font-weight:800;font-size:10.5px;border:none;cursor:pointer;white-space:nowrap;font-family:'Rajdhani',sans-serif;letter-spacing:1px;text-transform:uppercase;box-shadow:0 3px 0 rgba(90,10,15,.7),0 4px 15px rgba(230,36,41,.5);transition:.1s}
.missionCard .mClaim:active{transform:translateY(2px);box-shadow:0 1px 0 rgba(90,10,15,.7)}

/* STATS */
.statsGrid{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.statCard{background:linear-gradient(160deg, rgba(30,30,40,.75), rgba(15,15,25,.92));border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:15px 11px;text-align:center;position:relative;overflow:hidden;box-shadow:inset 0 1px 0 rgba(255,255,255,.06);backdrop-filter:blur(8px);transition:.2s}
.statCard::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(230,36,41,.8),transparent);box-shadow:0 0 15px rgba(230,36,41,.6)}
.statCard .stIcon{font-size:22px;margin-bottom:7px;opacity:.95;filter:drop-shadow(0 0 10px rgba(230,36,41,.4))}
.statCard .stValue{font-size:19px;font-weight:900;color:#fff;font-variant-numeric:tabular-nums;line-height:1;text-shadow:0 0 20px rgba(230,36,41,.5)}
.statCard .stLabel{font-size:9.5px;color:#8a8a95;margin-top:6px;font-weight:700;letter-spacing:1.2px;font-family:'Rajdhani',sans-serif;text-transform:uppercase}

/* SETTINGS */
.settingsHero{background:linear-gradient(160deg, rgba(230,36,41,.15), rgba(255,184,0,.08));border:1px solid rgba(230,36,41,.35);border-radius:20px;padding:22px 18px;text-align:center;position:relative;overflow:hidden;margin-bottom:16px;backdrop-filter:blur(10px)}
.settingsHero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 0%, rgba(230,36,41,.25), transparent 60%);pointer-events:none}
.settingsAvatar{width:88px;height:88px;border-radius:50%;margin:0 auto 14px;background:linear-gradient(135deg,#E62429,#8B0F14);border:3px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:38px;position:relative;z-index:1;box-shadow:0 0 40px rgba(230,36,41,.7),inset 0 2px 0 rgba(255,255,255,.3);letter-spacing:-1px;font-family:'Rajdhani',sans-serif}
.settingsName{font-size:22px;font-weight:900;color:#fff;font-family:'Rajdhani',sans-serif;letter-spacing:1px;margin-bottom:4px;position:relative;z-index:1;text-shadow:0 0 20px rgba(230,36,41,.4)}
.settingsRank{display:inline-block;font-size:10.5px;font-weight:800;color:#FFB800;background:rgba(255,184,0,.12);border:1px solid rgba(255,184,0,.4);padding:5px 12px;border-radius:99px;letter-spacing:2px;font-family:'Rajdhani',sans-serif;position:relative;z-index:1}
.settingsSince{font-size:10px;color:#8a8a95;letter-spacing:1px;position:relative;z-index:1;margin-top:8px}
.settingsSection{margin-bottom:18px}
.settingsSection h3{font-size:11.5px;color:#E62429;font-weight:800;letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;font-family:'Rajdhani',sans-serif;display:flex;align-items:center;gap:6px}
.settingsSection h3::before{content:'';width:3px;height:12px;background:#E62429;border-radius:2px;box-shadow:0 0 10px rgba(230,36,41,.8)}
.settingsItem{display:flex;align-items:center;gap:12px;background:linear-gradient(160deg, rgba(30,30,40,.75), rgba(15,15,25,.92));border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:13px;margin-bottom:9px;transition:.2s;cursor:pointer}
.settingsItem:active{transform:scale(.98)}
.settingsItem .siIcon{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.02));display:flex;align-items:center;justify-content:center;font-size:19px;flex-shrink:0;border:1px solid rgba(255,255,255,.08)}
.settingsItem .siBody{flex:1;min-width:0}
.settingsItem .siTitle{font-size:13px;font-weight:800;color:#fff;margin-bottom:3px;font-family:'Rajdhani',sans-serif;letter-spacing:.5px;text-transform:uppercase}
.settingsItem .siDesc{font-size:10.5px;color:#8a8a95;line-height:1.4;font-weight:500}
.settingsItem .siArrow{color:#5a5a65;font-size:14px;flex-shrink:0}
.settingsItem.danger{border-color:rgba(230,36,41,.4);background:linear-gradient(160deg, rgba(58,10,8,.5), rgba(26,5,4,.7))}
.settingsItem.danger .siTitle{color:#FF3B42}
.tutorialBox{background:linear-gradient(160deg, rgba(30,30,40,.75), rgba(15,15,25,.92));border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:16px}
.tutorialStep{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.05)}
.tutorialStep:last-child{border-bottom:none}
.tutorialStep .tsNum{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#E62429,#8B0F14);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;flex-shrink:0;box-shadow:0 0 12px rgba(230,36,41,.5);font-family:'Rajdhani',sans-serif}
.tutorialStep .tsBody{flex:1;font-size:11.5px;color:#c8c8d0;line-height:1.6;font-weight:500}
.tutorialStep .tsBody b{color:#FFB800;font-weight:800}

/* FX */
.floaty{position:absolute;font-weight:900;font-size:26px;color:#FFB800;pointer-events:none;z-index:60;font-variant-numeric:tabular-nums;letter-spacing:-1px;text-shadow:0 0 20px rgba(255,184,0,1),0 0 45px rgba(255,184,0,.6),0 2px 0 rgba(0,0,0,.4);animation:floatUp 1.1s cubic-bezier(.2,.8,.2,1) forwards}
@keyframes floatUp{0%{transform:translate(-50%,-50%) scale(.5);opacity:0}15%{transform:translate(-50%,-60%) scale(1.25);opacity:1}100%{transform:translate(-50%,-180px) scale(1);opacity:0}}
.pt{position:absolute;border-radius:50%;pointer-events:none;z-index:55;animation:ptBurst .95s cubic-bezier(.2,.8,.3,1) forwards}
@keyframes ptBurst{0%{transform:translate(-50%,-50%) scale(1.4);opacity:1}100%{transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(0);opacity:0}}
.glass{position:absolute;pointer-events:none;z-index:56;background:linear-gradient(135deg, rgba(255,255,255,.9), rgba(255,184,0,.6));animation:glassSpin 1.1s ease-out forwards;clip-path:polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%)}
@keyframes glassSpin{0%{transform:translate(-50%,-50%) rotate(0deg) scale(.5);opacity:1}100%{transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) rotate(720deg) scale(0);opacity:0}}
.ripple{position:absolute;border-radius:50%;pointer-events:none;z-index:50;border:2px solid rgba(255,184,0,.8);transform:translate(-50%,-50%);animation:rippleOut .7s cubic-bezier(.2,.8,.3,1) forwards;box-shadow:0 0 20px rgba(255,184,0,.5)}
@keyframes rippleOut{from{width:0;height:0;opacity:1;border-width:5px}to{width:280px;height:280px;opacity:0;border-width:1px}}
.sparkLine{position:absolute;height:3px;pointer-events:none;z-index:58;background:linear-gradient(90deg,transparent,#fff,transparent);transform-origin:center;animation:sparkFade .55s ease-out forwards;box-shadow:0 0 10px #fff}
@keyframes sparkFade{0%{opacity:1;transform:translate(-50%,-50%) scaleX(0)}50%{opacity:1;transform:translate(-50%,-50%) scaleX(1)}100%{opacity:0;transform:translate(-50%,-50%) scaleX(1.5)}}
.critFlash{position:fixed;inset:0;pointer-events:none;z-index:150;background:radial-gradient(circle at center, rgba(255,184,0,.6), transparent 60%);animation:critFlashAnim .45s ease-out forwards;mix-blend-mode:screen}
@keyframes critFlashAnim{from{opacity:1}to{opacity:0}}
.megaFlash{position:fixed;inset:0;pointer-events:none;z-index:150;background:radial-gradient(circle at center, rgba(255,255,255,.9) 0%, rgba(230,36,41,.6) 20%, transparent 70%);animation:critFlashAnim .55s ease-out forwards;mix-blend-mode:screen}
.killfeed{position:absolute;top:70px;left:14px;display:flex;flex-direction:column;gap:5px;pointer-events:none;z-index:90;max-width:180px}
.kf{background:linear-gradient(90deg, rgba(230,36,41,.3), rgba(230,36,41,.05));border-left:3px solid #E62429;padding:6px 11px;font-size:10px;font-family:'Rajdhani',sans-serif;font-weight:700;letter-spacing:1px;color:#fff;border-radius:3px;animation:kfIn .3s ease, kfOut .5s ease 1.8s forwards;text-transform:uppercase;box-shadow:0 0 20px rgba(230,36,41,.4);backdrop-filter:blur(6px)}
@keyframes kfIn{from{opacity:0;transform:translateX(-25px)}to{opacity:1;transform:translateX(0)}}
@keyframes kfOut{to{opacity:0;transform:translateX(-25px)}}
#toast{position:absolute;top:80px;left:50%;transform:translateX(-50%) translateY(-20px);background:linear-gradient(135deg,#E62429,#8B0F14);color:#fff;padding:12px 24px;border-radius:13px;font-size:12px;font-weight:800;opacity:0;transition:.3s;z-index:300;pointer-events:none;box-shadow:0 12px 40px rgba(230,36,41,.6),inset 0 1px 0 rgba(255,255,255,.2);letter-spacing:.5px;white-space:nowrap;border:1px solid rgba(255,255,255,.15);text-transform:uppercase;font-family:'Rajdhani',sans-serif;backdrop-filter:blur(10px)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.ok{background:linear-gradient(135deg,#FFB800,#B88000);color:#0a0500;box-shadow:0 0 40px rgba(255,184,0,.85)}
.rewardPopup{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(.7);background:linear-gradient(160deg,rgba(42,21,16,.98),rgba(26,10,8,.99));border:2px solid #FFB800;border-radius:22px;padding:26px 30px;text-align:center;z-index:500;opacity:0;pointer-events:none;transition:.4s cubic-bezier(.3,1.6,.6,1);box-shadow:0 0 100px rgba(255,184,0,.7),0 30px 70px rgba(0,0,0,.9);min-width:260px;backdrop-filter:blur(20px)}
.rewardPopup.show{opacity:1;pointer-events:auto;transform:translate(-50%,-50%) scale(1)}
.rewardPopup .rpIcon{font-size:56px;margin-bottom:8px;filter:drop-shadow(0 0 25px rgba(255,184,0,.9))}
.rewardPopup .rpTitle{font-size:13px;font-weight:900;color:#FFB800;font-family:'Rajdhani',sans-serif;letter-spacing:2px;text-transform:uppercase;margin-bottom:6px}
.rewardPopup .rpAmount{font-size:38px;font-weight:900;color:#fff;font-family:'Rajdhani',sans-serif;text-shadow:0 0 30px rgba(255,184,0,.8);letter-spacing:-1px}
.rewardPopup .rpSub{font-size:10.5px;color:#8a8a95;margin-top:8px;letter-spacing:1px;text-transform:uppercase}
.lightning{position:fixed;inset:0;pointer-events:none;z-index:120;background:radial-gradient(circle at 50% 0%, rgba(255,255,255,.9), rgba(230,36,41,.4) 30%, transparent 70%);opacity:0}
.lightning.flash{animation:lightFlash .5s ease-out}
@keyframes lightFlash{0%{opacity:0}10%{opacity:1}20%{opacity:.2}30%{opacity:1}100%{opacity:0}}
</style>
